# Environment Configuration for Alert Fatigue Buster

# Application
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO
PROJECT_NAME="Alert Fatigue Buster API"
API_V1_PREFIX="/api/v1"

# Database Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=alert_buster
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# SQLAlchemy Database URL
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/alert_buster

# Phase 2 Intelligence Parameters
DEDUP_WINDOW_SECONDS=300
STORM_WINDOW_SECONDS=60
STORM_ALERT_THRESHOLD=20
CORRELATION_WINDOW_SECONDS=900

# Phase 3 Decision & Notification Parameters
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL
SLACK_BOT_TOKEN=YOUR_SLACK_BOT_TOKEN
SLACK_CHANNEL=#alerts

SLACK_ENABLED=false
ALERT_COOLDOWN_SECONDS=300
ESCALATION_THRESHOLD_SECONDS=600
ESCALATION_OCCURRENCE_THRESHOLD=10

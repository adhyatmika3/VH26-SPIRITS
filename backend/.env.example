ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO
PROJECT_NAME="Alert Fatigue Buster API"
API_V1_PREFIX="/api/v1"
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/alert_buster
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=alert_buster
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# SMTP Escalation
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=your-smtp-user
SMTP_PASSWORD=your-smtp-password
SMTP_USE_TLS=true
ALERT_EMAIL_FROM=alerts@sre-platform.internal
ALERT_EMAIL_TO=sre-oncall@company.internal

# Slack Integration (Phase 8)
SLACK_ENABLED=false
SLACK_BOT_TOKEN=xoxb-your-bot-token
SLACK_SIGNING_SECRET=your-slack-signing-secret
SLACK_CHANNEL_ID=C0123456789
SLACK_CHANNEL=#alerts
DASHBOARD_BASE_URL=http://localhost:8000
